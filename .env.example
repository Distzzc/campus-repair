# Copy to .env. Never commit .env or put real secrets in this example.
# Required: development | testing | production; no implicit default.
APP_ENV=development

# Required for local execution: replace with your absolute project path.
# The existing parent directory must be writable. Relative paths, URI forms,
# :memory:, directories, and names without .sqlite3 are invalid.
# Create instance/ yourself, then explicitly run init-db before starting.
# Compose overrides this value with /data/campus-repair.sqlite3 in its volume;
# it also overrides APP_ENV with production. See compose.yaml for the explicit container environment.
DATABASE_PATH=/absolute/path/to/campus-repair/instance/campus-repair.sqlite3

# Optional: DEBUG | INFO | WARNING | ERROR; omitted default is INFO.
# Request completion logs remain enabled regardless of this value.
LOG_LEVEL=INFO

# Optional: decimal integer 1..10; omitted default is 2 seconds.
DB_TIMEOUT_SECONDS=2

# Optional Compose host port: decimal integer 1024..65535; default is 8000.
# Local Gunicorn uses the explicit --bind argument, not this variable.
HOST_PORT=8000

# Explicit empty optional values are invalid, not a request for defaults.
# The application reads process environment only; it does not auto-load .env.
# Local commands use dotenv -f .env run; Compose uses --env-file .env.
